{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S3 requirements.json",
  "description": "S3 声明与关系；不表示已生效产品配置、GN 求值结果或验证通过。详见 src/l2_extract/README.md。",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "kind",
      "name",
      "at"
    ],
    "additionalProperties": false,
    "properties": {
      "kind": {
        "enum": [
          "component",
          "requires",
          "selects",
          "inherits",
          "system_component",
          "build_targets",
          "conditional_requires",
          "subsystem",
          "subsystem_components"
        ]
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "at": {
        "type": "string",
        "pattern": ".+:[1-9][0-9]*$"
      },
      "from": {
        "type": "string",
        "minLength": 1
      },
      "category": {
        "type": "string"
      },
      "options": {
        "type": "object"
      },
      "features": {
        "type": "array"
      },
      "adapted_system_type": {
        "type": "array"
      },
      "adapted_kernel": {
        "type": "array"
      },
      "field": {
        "type": "string"
      },
      "targets": {},
      "value": {},
      "template": {
        "enum": [
          "lite_subsystem",
          "lite_subsystem_test"
        ]
      },
      "op": {
        "enum": [
          "=",
          "+=",
          "-="
        ]
      },
      "when": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "symbolic": {
        "const": true
      },
      "expression": {
        "type": "string",
        "minLength": 1
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "kind": {
              "enum": [
                "requires",
                "selects",
                "inherits",
                "system_component"
              ]
            }
          }
        },
        "then": {
          "required": [
            "from"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "build_targets"
            }
          }
        },
        "then": {
          "required": [
            "field",
            "targets"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "conditional_requires"
            }
          }
        },
        "then": {
          "required": [
            "category",
            "value",
            "symbolic"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "subsystem"
            }
          }
        },
        "then": {
          "required": [
            "template"
          ]
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "subsystem_components"
            }
          }
        },
        "then": {
          "required": [
            "op"
          ],
          "oneOf": [
            {
              "required": [
                "targets"
              ],
              "properties": {
                "targets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            {
              "required": [
                "expression",
                "symbolic"
              ]
            }
          ]
        }
      }
    ]
  }
}
